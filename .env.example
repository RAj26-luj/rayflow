# RAYFLOW Production Environment Configuration Template
# Copy this file to .env.local (or configure in Vercel / Docker environment)

# -------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM)
# -------------------------------------------------------------
# Production (PostgreSQL e.g. Neon, Supabase, Railway, Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rayflow?schema=public"
# Zero-config Local Development / Testing:
DATABASE_URL="file:./dev.db"

# -------------------------------------------------------------
# 2. NEXTAUTH / AUTH.JS CONFIGURATION
# -------------------------------------------------------------
# Canonical URL of your deployment
NEXTAUTH_URL="http://localhost:3000"
# Generate a secure 32+ char secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace_with_openssl_rand_base64_32"

# -------------------------------------------------------------
# 3. RAZORPAY TEST & PRODUCTION CREDENTIALS
# -------------------------------------------------------------
# Obtain from Razorpay Dashboard → Settings → API Keys (Test Mode)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Public key for browser Razorpay Checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# -------------------------------------------------------------
# 4. OPTIONAL AI PROVIDER (OPENROUTER / DETERMINISTIC)
# -------------------------------------------------------------
# Optional external LLM key. If omitted or empty, RAYFLOW runs 100% deterministically.
AI_PROVIDER="deterministic" # "deterministic" | "openrouter"
OPENROUTER_API_KEY=""
DEFAULT_AI_MODEL="google/gemini-2.5-flash"

# -------------------------------------------------------------
# 5. DEMO & PRODUCTION SAFETY CONTROLS
# -------------------------------------------------------------
# Set to 'false' in production to disable database wipe/reset API endpoints
DEMO_MODE="false"
